# Server
PORT=5000
NODE_ENV=production

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ai_resume_analyzer
MONGO_URI=mongodb://localhost:27017/ai_resume_analyzer

# JWT
JWT_SECRET=your_jwt_secret_key_change_this
JWT_EXPIRES_IN=7d



# Frontend URL used in verification and password-reset links
CLIENT_URL=https://your-domain.com
COOKIE_SAME_SITE=lax

# OpenAI-compatible provider
OPENAI_API_KEY=your_groq_api_key
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Job Search APIs
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
JSEARCH_API_KEY=your_rapidapi_jsearch_key

# Reliability/security tuning
EXTERNAL_API_TIMEOUT_MS=30000
RATE_LIMIT_MAX=300
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
